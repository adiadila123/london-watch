# Copy to server/.env and fill in real values before running the app.

# Signs Flask's session cookie - any long random string.
SECRET_KEY=change-me-to-a-long-random-string

# Salt mixed into the IP hash used for confirmation dedup and submission
# rate-limiting (server/db.py hash_voter). Any long random string.
VOTER_HASH_SALT=change-me-to-a-different-long-random-string

# Max report submissions accepted per hashed-IP per hour.
MAX_REPORTS_PER_HOUR=8
